#include <stdio.h>

int main() {
    int n;

    printf("Quantas pessoas? ");
    scanf("%d", &n);

    char nomes[n][100];
    int idades[n];
    double alturas[n];

    double soma_alt = 0.0;
    int menores = 0;

    for (int i = 0; i < n; i++) {
        printf("\nPessoa %d\n", i + 1);
        printf("Nome: ");
        scanf(" %99[^\n]", nomes[i]);
        printf("Idade: ");
        scanf("%d", &idades[i]);
        printf("Altura: ");
        scanf("%lf", &alturas[i]);

        soma_alt += alturas[i];
        if (idades[i] < 16) {
            menores++;
        }
    }

    double media = soma_alt / n;
    double porc_menores = ((double)menores / n) * 100.0;

    printf("\nAltura media: %.2lf\n", media);
    printf("Menores de 16 anos: %.1lf%%\n", porc_menores);

    return 0;
}
