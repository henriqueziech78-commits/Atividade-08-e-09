#include <stdio.h>

int main() {
    int n;

    printf("Quantos numeros? ");
    scanf("%d", &n);

    double vet[n];

    for (int i = 0; i < n; i++) {
        printf("Numero %d: ", i + 1);
        scanf("%lf", &vet[i]);
    }

    printf("\nNumeros digitados:\n");
    for (int i = 0; i < n; i++) {
        printf("%.2lf\n", vet[i]);
    }

    return 0;
}
